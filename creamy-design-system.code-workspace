{
  "folders": [{ "path": "." }],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "typescript.tsdk": "node_modules/typescript/lib",
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#7A1F1F",
      "titleBar.activeForeground": "#FFFFFF",
      "titleBar.inactiveBackground": "#5C1717",
      "titleBar.inactiveForeground": "#FFFFFF99",
      "activityBar.background": "#7A1F1F",
      "activityBar.foreground": "#FFFFFF",
      "activityBar.inactiveForeground": "#FFFFFF66",
      "statusBar.background": "#7A1F1F",
      "statusBar.foreground": "#FFFFFF",
      "statusBarItem.hoverBackground": "#962727"
    }
  },
  "extensions": {
    "recommendations": [
      "angular.ng-template",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint"
    ]
  },
  "launch": {
    "configurations": [
      {
        "name": "Serve creamy-design-system (Angular, port 4203)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["start"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      }
    ]
  }
}
